{
  "file_scan_exclusions": ["**/.direnv", "**/target"],
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": ["./Cargo.toml"],
        "cargo": { "features": "all", "targetDir": true },
        "check": {
          "command": "clippy",
          "features": "all",
          "workspace": false
        }
      }
    }
  }
}
