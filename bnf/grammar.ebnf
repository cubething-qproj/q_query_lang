; q_fs query language - normative grammar, v0

query           = term *("|" term)

term            = path / single
single          = %s"single(" query ")"

path            = [prefix] step *(sep step)
prefix          = "/" / "//"
sep             = "/" / "//"

step            = node-step / parent-step / fetch-step
node-step       = [rel-axis] node-test *predicate
parent-step     = ".." *predicate
fetch-step      = fetch *predicate *field

rel-axis        = type "::"       ; only Bevy Relationship/RelationshipTarget components
node-test       = name-test / wildcard
name-test       = "#" name
wildcard        = "*"

fetch           = entity-fetch / component-fetch / opt-fetch / opt-mut-fetch / mut-fetch
                / optional-wrap / mut-wrap / boolean-fetch / ref-fetch
entity-fetch    = "@"             ; Entity QueryData, never a component prefix
component-fetch = type            ; bare T = &T, including relationship components
opt-fetch       = "?" type
opt-mut-fetch   = "?^" type
mut-fetch       = "^" type
optional-wrap   = %s"optional(" (component-fetch / mut-wrap) ")"
mut-wrap        = %s"mut(" component-fetch ")"
boolean-fetch   = %s"boolean(" type ")"
ref-fetch       = %s"ref(" type ")"

type            = IDENT
name            = IDENT / quoted-name

predicate       = "[" pred-expr "]"
pred-expr       = or-expr
or-expr         = and-expr *(1*SP %s"or" 1*SP and-expr)
and-expr        = pred-atom *(and-sep pred-atom)
and-sep         = 1*SP / 1*SP %s"and" 1*SP
pred-atom       = presence / tick / positional / not-group / pred-group
presence        = ("+" / "-") type / %s"with(" type ")"
                / %s"without(" type ")"
tick            = %s"changed(" type ")"
                / %s"added(" type ")"
                / %s"spawned()"
positional      = INT / %s"last()"
not-group       = %s"not(" pred-expr ")"
pred-group      = "(" pred-expr ")"

field           = "." field-name / "[" positional "]"
field-name      = IDENT / INT          ; INT = tuple fields (.0)

; lexical terminals
IDENT           = (ALPHA / "_") *(ALPHA / DIGIT / "_")
INT             = 1*DIGIT
quoted-name     = DQUOTE 1*(%x21 / %x23-7E / SP) DQUOTE
